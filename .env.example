# =====================================================
# Sana Quran Academy — Environment Variables
# NEVER commit real secrets. Copy this file to .env and fill in values.
# =====================================================

# ---- Database (Supabase Postgres) ----
# Runtime connection. On Vercel use the Supabase *Transaction Pooler* (port 6543)
# so serverless functions do not exhaust Postgres connections.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct (session, NON-pooled) connection used by Prisma Migrate only (port 5432).
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---- Auth (custom JWT sessions via jose — NOT NextAuth) ----
# IMPORTANT: generate a strong random 64-char secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="REPLACE_WITH_A_STRONG_RANDOM_64_CHAR_HEX_SECRET"

# ---- Supabase Storage (server-side only; NEVER expose the service-role key) ----
# Project URL, e.g. https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
# SERVICE ROLE key — server-only secret. Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY"
# Target storage bucket for uploads (payment proofs, avatars).
SUPABASE_STORAGE_BUCKET="sana-uploads"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="201023290018"
