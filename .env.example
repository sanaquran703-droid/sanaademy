# =====================================================
# Sana Quran Academy — Environment Variables
# NEVER commit real secrets. Copy this file to .env and fill in values.
# =====================================================

# ---- Database (Supabase Postgres) ----
# Main connection (used at runtime)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# Direct (pooled) connection (used by migrations only)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---- Auth (custom JWT sessions via jose — NOT NextAuth) ----
# IMPORTANT: generate a strong random 64-char secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="REPLACE_WITH_A_STRONG_RANDOM_64_CHAR_HEX_SECRET"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="201023290018"
