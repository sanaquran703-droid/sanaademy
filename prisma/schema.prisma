// Sana Academy — Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  student
  teacher
  admin
}

enum Gender {
  female
  male
}

enum LessonStatus {
  scheduled
  completed
  absent
  postponed
  cancelled
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum PaymentStatus {
  pending
  confirmed
  rejected
}

enum EvaluationGrade {
  excellent
  very_good
  good
  needs_review
}

enum EnrollmentStatus {
  active
  paused
  completed
  withdrawn
}

enum MeetingProvider {
  google_meet
  zoom
  discord
  teams
  other
}

model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  email              String?   @unique
  passwordHash       String
  role               UserRole
  fullName           String
  phone              String?
  avatarUrl          String?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  student  Student?
  teacher  Teacher?
  admin    Admin?

  @@index([role])
}

model Program {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  enrollments Enrollment[]
  groups      Group[]
}

model Student {
  id            String    @id @default(uuid())
  userId        String    @unique
  gender        Gender    @default(female)
  birthDate     DateTime?
  guardianName  String?
  guardianPhone String?
  notes         String?
  joinedAt      DateTime  @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  memorizationPlan MemorizationPlan?
  enrollments      Enrollment[]
  lessons          Lesson[]
  attendance       Attendance[]
  evaluations      Evaluation[]
  payments         Payment[]
}

model Teacher {
  id        String   @id @default(uuid())
  userId    String   @unique
  bio       String?
  specialty String?
  joinedAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups Group[]
}

model Admin {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Yearly enrollment tying a student to a program/group in a specific academic year.
model Enrollment {
  id           String           @id @default(uuid())
  studentId    String
  academicYear String           // "2026-2027"
  programId    String?
  groupId      String?
  startDate    DateTime
  endDate      DateTime?
  status       EnrollmentStatus @default(active)
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id])
  group   Group?   @relation(fields: [groupId], references: [id])

  @@unique([studentId, academicYear])
  @@index([academicYear, status])
  @@index([groupId])
}

model Group {
  id              String          @id @default(uuid())
  name            String
  teacherId       String?
  programId       String?
  meetingProvider MeetingProvider @default(google_meet)
  meetLink        String?
  maxStudents     Int             @default(10)
  isActive        Boolean         @default(true)
  academicYear    String?         // active academic year for this group
  createdAt       DateTime        @default(now())

  teacher     Teacher?     @relation(fields: [teacherId], references: [id])
  program     Program?     @relation(fields: [programId], references: [id])
  enrollments Enrollment[]
  schedules   Schedule[]
  lessons     Lesson[]

  @@index([teacherId])
}

model Schedule {
  id           String @id @default(uuid())
  groupId      String
  dayOfWeek    Int    // 0=Sunday .. 6=Saturday
  startTime    String // "HH:mm"
  durationMins Int    @default(45)
  timezone     String @default("Africa/Cairo")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model MemorizationPlan {
  id              String   @id @default(uuid())
  studentId       String   @unique
  currentSurah    String?
  currentAyahFrom Int?
  currentAyahTo   Int?
  reviewSurah     String?
  reviewAyahFrom  Int?
  reviewAyahTo    Int?
  progressPct     Int      @default(0)
  notes           String?
  updatedAt       DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Lesson {
  id                  String       @id @default(uuid())
  groupId             String
  studentId           String?      // null = group-level lesson
  scheduledAt         DateTime
  status              LessonStatus @default(scheduled)
  meetLink            String?
  newPortion          String?      // e.g. "آل عمران 1-10"
  reviewPortion       String?
  errorsCount         Int?
  errorsType          String?      // "تجويد", "نطق", "نسيان" — free-text
  hasNewMemorization  Boolean      @default(true)
  homework            String?      // required for next lesson
  teacherNotes        String?
  rescheduledTo       DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  group      Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student    Student?     @relation(fields: [studentId], references: [id])
  attendance Attendance[]
  evaluation Evaluation?

  @@index([groupId])
  @@index([studentId])
  @@index([scheduledAt])
}

model Attendance {
  id        String           @id @default(uuid())
  lessonId  String
  studentId String
  status    AttendanceStatus @default(present)
  note      String?

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model Evaluation {
  id           String          @id @default(uuid())
  lessonId     String          @unique
  studentId    String
  memorization EvaluationGrade @default(good)
  review       EvaluationGrade @default(good)
  tajweed      EvaluationGrade @default(good)
  commitment   EvaluationGrade @default(good)
  overallNote  String?
  createdAt    DateTime        @default(now())

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Payment {
  id           String        @id @default(uuid())
  studentId    String
  amount       Decimal       @db.Decimal(10, 2)
  currency     String        @default("EGP")
  monthCovered String        // "2026-08"
  method       String        @default("instapay")
  proofUrl     String?
  status       PaymentStatus @default(pending)
  submittedAt  DateTime      @default(now())
  confirmedAt  DateTime?
  confirmedBy  String?       // admin userId
  note         String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

// Simple in-DB rate limit tracking (fallback when no Redis)
model LoginAttempt {
  id        String   @id @default(uuid())
  ipHash    String
  username  String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([username, createdAt])
}
